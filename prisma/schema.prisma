// https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(cuid())
  telegramId BigInt   @unique
  firstName  String?
  lastName   String?
  username   String?
  photoUrl   String?
  authDate   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
