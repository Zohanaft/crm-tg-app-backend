// https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id             Int      @id
  name           String   @unique
  maxWorkspaces  Int
  users          User[]

  @@map("plans")
}

model User {
  id               String   @id @default(cuid())
  telegramId       BigInt   @unique
  firstName        String?
  lastName         String?
  username         String?
  photoUrl         String?
  authDate         Int?
  planId           Int      @default(1)
  plan             Plan     @relation(fields: [planId], references: [id])
  planExpiresAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bots             TgBot[]
  ownedWorkspaces  Workspace[]        @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  clientOwners     ClientOwner[]
  invitesCreated   WorkspaceInvite[] @relation("InviteInviter")
  invitesReceived  WorkspaceInvite[] @relation("InviteInvitee")
  actionsAsActor   Action[]          @relation("ActionActor")
  actionsAsRecipient Action[]        @relation("ActionRecipient")
  actionReads      ActionRead[]
  productCards     ProductCard[]

  @@map("users")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerName String?
  countryCc String   @default("ru")
  countryCode String @default("RU")
  members   WorkspaceMember[]
  invites   WorkspaceInvite[]
  actions   Action[]
  cardLinks CardWorkspace[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspaces")
}

model ProductCard {
  id               String          @id @default(cuid())
  title            String
  description      String
  workspaceOwnerId String
  workspaceOwner   User            @relation(fields: [workspaceOwnerId], references: [id], onDelete: Cascade)
  workspaceLinks   CardWorkspace[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([workspaceOwnerId])
  @@map("product_cards")
}

model CardWorkspace {
  id          String      @id @default(cuid())
  cardId      String
  card        ProductCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([cardId, workspaceId])
  @@index([cardId])
  @@index([workspaceId])
  @@map("card_workspace_links")
}

model FilesService {
  id           String   @id @default(cuid())
  url          String
  cid          String
  entityName   String
  originalName String
  key          String   @unique
  createdAt    DateTime @default(now())

  @@index([entityName, cid])
  @@map("files_service")
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model WorkspaceInvite {
  id               String                @id @default(cuid())
  workspaceId      String
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedByUserId  String
  invitedBy        User                  @relation("InviteInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  invitedUserId    String
  invitedUser      User                  @relation("InviteInvitee", fields: [invitedUserId], references: [id], onDelete: Cascade)
  status           WorkspaceInviteStatus @default(PENDING)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([invitedUserId, status])
  @@index([workspaceId, status])
  @@map("workspace_invites")
}

model Action {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type             String
  title            String
  meta             Json?
  actorUserId      String?
  actor            User?     @relation("ActionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  recipientUserId  String?
  recipient        User?     @relation("ActionRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  dedupKey         String?
  reads            ActionRead[]
  createdAt        DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([recipientUserId])
  @@unique([workspaceId, type, dedupKey])
  @@map("actions")
}

model ActionRead {
  id        String   @id @default(cuid())
  actionId  String
  action    Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([actionId, userId])
  @@index([userId, readAt])
  @@map("action_reads")
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model TgBot {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookSecret           String?  @unique
  botId                   BigInt   @unique
  token                   String   @unique
  isBot                   Boolean?
  firstName               String?
  username                String?
  canJoinGroups           Boolean?
  canReadAllGroupMessages Boolean?
  supportsInlineQueries   Boolean?
  rawData                 Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId])
  @@map("tg_bots")
}

model Client {
  id         String        @id @default(cuid())
  telegramId BigInt        @unique
  isBot      Boolean       @default(false)
  firstName  String
  lastName   String?
  username   String?
  chatId     BigInt?
  chatType   String?
  owners     ClientOwner[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("clients")
}

model ClientOwner {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clientId, ownerId])
  @@index([ownerId])
  @@index([clientId])
  @@map("client_owner_links")
}
