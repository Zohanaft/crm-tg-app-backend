# Telegram bot connect (production: set base URL to public HTTPS API root, e.g. https://api.example.com or https://domain.com/api)
TELEGRAM_WEBHOOK_BASE_URL=
# Local dev: skip webhook + allow connect without public URL
TELEGRAM_WEBHOOK_SKIP=true
BOT_DEFAULT_DESCRIPTION=CRM Telegram bot
BOT_DEFAULT_SHORT_DESCRIPTION=CRM
